{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "MetOrigin Splat",
  "mainBinaryName": "MetOrigin Splat",
  "version": "0.1.0",
  "identifier": "com.metorigin.splat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "MetOrigin Splat",
        "width": 1440,
        "height": 1024,
        "minWidth": 1024,
        "minHeight": 768,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "useLocalToolsDir": true,
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../.engines/windows-x64/distribution/engines/": "resources/engines/",
      "../../../.engines/windows-x64/distribution/licenses/": "resources/licenses/",
      "../../../.engines/windows-x64/distribution/installer/": "resources/installer/"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "wix": null,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "nsis/full-installer-hooks.nsh"
      }
    }
  }
}
