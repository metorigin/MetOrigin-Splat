{
  "name": "splat-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node ../../integrations/supersplat/prepare.mjs",
    "prebuild": "node ../../integrations/supersplat/prepare.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:windows:release": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../../scripts/windows/Build-WindowsRelease.ps1",
    "package:windows:full": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../../scripts/windows/Build-FullInstaller.ps1",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --cache=false"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@sparkjsdev/spark": "2.1.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "lucide-react": "1.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
