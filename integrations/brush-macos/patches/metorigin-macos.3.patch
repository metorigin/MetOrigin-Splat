+/// Tokenize args.txt without shell expansion. Quotes preserve whitespace and
+/// backslash escapes the next character outside single quotes.
+pub fn split_args_str(content: &str) -> Result<Vec<String>, &'static str> {
+    let mut args = Vec::new();
+    let mut token = String::new();
+    let mut quote = None;
+    let mut escaped = false;
+    let mut started = false;
+    for ch in content.chars() {
+        if escaped {
+            token.push(ch);
+            escaped = false;
+        } else if ch == '\\' && quote != Some('\'') {
+            escaped = true;
+            started = true;
+        } else if quote == Some(ch) {
+            quote = None;
+        } else if quote.is_none() && (ch == '\'' || ch == '"') {
+            quote = Some(ch);
+            started = true;
+        } else if quote.is_none() && ch.is_whitespace() {
+            if started {
+                args.push(std::mem::take(&mut token));
+                started = false;
+            }
+        } else {
+            token.push(ch);
+            started = true;
+        }
+    }
+    if escaped || quote.is_some() {
+        return Err("Unterminated quote or escape in args.txt");
+    }
+    if started {
+        args.push(token);
+    }
+    Ok(args)
+}
+
+/// Inverse of `split_args_str`, including empty values, quotes and Unicode paths.
+pub fn format_args(args: &[String]) -> String {
+    args.iter()
+        .map(|arg| {
+            if !arg.is_empty()
+                && arg
+                    .chars()
+                    .all(|c| !c.is_whitespace() && !['\'', '"', '\\'].contains(&c))
+            {
+                arg.clone()
+            } else {
+                format!("'{}'", arg.replace('\'', "'\\''"))
+            }
+        })
+        .collect::<Vec<_>>()
+        .join(" ")
 }
 
