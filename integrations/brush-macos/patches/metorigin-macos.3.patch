@@ -0,0 +1,203 @@
+//! Commit complete, validated PLY checkpoints with an atomic same-directory rename.
+
+use std::{
+    fs::{File, OpenOptions},
+    io::{self, Write},
+    path::{Path, PathBuf},
+    sync::atomic::{AtomicU64, Ordering},
+};
+
+use anyhow::{Context, Result, ensure};
+
+static NEXT_TEMP: AtomicU64 = AtomicU64::new(0);
+const CORE_FIELDS: [&str; 14] = [
+    "x", "y", "z", "scale_0", "scale_1", "scale_2", "opacity", "rot_0", "rot_1", "rot_2", "rot_3",
+    "f_dc_0", "f_dc_1", "f_dc_2",
+];
+
+/// Validate the exact binary schema emitted by Brush's official serializer,
+/// including the full payload. A finite prefix or a valid header is insufficient.
+fn validate_ply(bytes: &[u8]) -> Result<()> {
+    let marker = b"end_header\n";
+    let header_end = bytes
+        .windows(marker.len())
+        .position(|w| w == marker)
+        .context("Missing PLY header terminator")?
+        + marker.len();
+    ensure!(header_end <= 65_536, "Oversized PLY header");
+    let header = std::str::from_utf8(&bytes[..header_end]).context("Invalid PLY header")?;
+    let mut lines = header.lines();
+    ensure!(lines.next() == Some("ply"), "Missing PLY magic");
+    ensure!(
+        lines.next() == Some("format binary_little_endian 1.0"),
+        "Unexpected PLY encoding"
+    );
+    let mut count = None;
+    let mut fields = Vec::new();
+    for line in lines {
+        let words = line.split_whitespace().collect::<Vec<_>>();
+        match words.as_slice() {
+            ["comment", ..] | ["end_header"] => {}
+            ["element", "vertex", n] if count.is_none() => count = Some(n.parse::<usize>()?),
+            ["property", "float", name] if count.is_some() => fields.push(*name),
+            _ => anyhow::bail!("Unexpected PLY declaration"),
+        }
+    }
+    let count = count.context("Missing PLY vertex count")?;
+    ensure!(count > 0, "Empty checkpoint");
+    ensure!(fields.starts_with(&CORE_FIELDS), "Missing Gaussian fields");
+    let rest = fields.len() - CORE_FIELDS.len();
+    ensure!(
+        [0, 9, 24, 45, 72].contains(&rest),
+        "Incomplete spherical harmonics"
+    );
+    for (index, field) in fields[CORE_FIELDS.len()..].iter().enumerate() {
+        ensure!(
+            *field == format!("f_rest_{index}"),
+            "Invalid spherical harmonic fields"
+        );
+    }
+    let payload_len = count
+        .checked_mul(fields.len())
+        .and_then(|n| n.checked_mul(4))
+        .context("PLY payload length overflow")?;
+    let payload = &bytes[header_end..];
+    ensure!(payload.len() == payload_len, "Incomplete PLY payload");
+    for scalar in payload.chunks_exact(4) {
+        let value = f32::from_le_bytes(scalar.try_into().expect("four-byte scalar"));
+        ensure!(value.is_finite(), "Non-finite Gaussian value");
+    }
+    Ok(())
+}
+
+struct PendingCheckpoint {
+    path: PathBuf,
+    file: File,
+}
+
+impl PendingCheckpoint {
+    fn create(parent: &Path) -> io::Result<Self> {
+        loop {
+            let serial = NEXT_TEMP.fetch_add(1, Ordering::Relaxed);
+            let path = parent.join(format!(
+                ".brush-checkpoint-{}-{serial}.part",
+                std::process::id()
+            ));
+            match OpenOptions::new().write(true).create_new(true).open(&path) {
+                Ok(file) => return Ok(Self { path, file }),
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+                Err(error) => return Err(error),
+            }
+        }
+    }
+}
+
+impl Drop for PendingCheckpoint {
+    fn drop(&mut self) {
+        // SIGKILL can leave a .part file; it is never named as a checkpoint.
+        let _ = std::fs::remove_file(&self.path);
+    }
+}
+
+fn write_checkpoint_with(
+    path: &Path,
+    bytes: &[u8],
+    write: impl FnOnce(&mut File, &[u8]) -> io::Result<()>,
+) -> Result<()> {
+    validate_ply(bytes).context("Refusing invalid checkpoint")?;
+    let parent = path
+        .parent()
+        .context("Checkpoint has no parent directory")?;
+    let mut pending =
+        PendingCheckpoint::create(parent).context("Creating checkpoint temporary file")?;
+    write(&mut pending.file, bytes).context("Writing checkpoint")?;
+    pending.file.sync_all().context("Syncing checkpoint")?;
+    std::fs::rename(&pending.path, path).context("Committing checkpoint")?;
+    #[cfg(unix)]
+    File::open(parent)?
+        .sync_all()
+        .context("Syncing checkpoint directory")?;
+    Ok(())
+}
+
+pub async fn write_checkpoint(path: PathBuf, bytes: Vec<u8>) -> Result<()> {
+    tokio::task::spawn_blocking(move || {
+        write_checkpoint_with(&path, &bytes, |file, data| file.write_all(data))
+    })
+    .await
+    .context("Checkpoint writer task failed")?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn payload(value: f32) -> Vec<u8> {
+        let mut header = "ply\nformat binary_little_endian 1.0\nelement vertex 1\n".to_owned();
+        for field in CORE_FIELDS {
+            header.push_str(&format!("property float {field}\n"));
+        }
+        header.push_str("end_header\n");
+        let mut bytes = header.into_bytes();
+        for _ in CORE_FIELDS {
+            bytes.extend(value.to_le_bytes());
+        }
+        bytes
+    }
+
+    fn test_directory() -> PathBuf {
+        let serial = NEXT_TEMP.fetch_add(1, Ordering::Relaxed);
+        let path = std::env::temp_dir().join(format!(
+            "brush-checkpoint-test-{}-{serial}",
+            std::process::id()
+        ));
+        std::fs::create_dir(&path).unwrap();
+        path
+    }
+
+    #[test]
+    fn validates_whole_payload_and_gaussian_schema() {
+        assert!(validate_ply(&payload(0.5)).is_ok());
+        let mut truncated = payload(0.5);
+        truncated.pop();
+        assert!(validate_ply(&truncated).is_err());
+        assert!(validate_ply(&payload(f32::NAN)).is_err());
+        let mut trailing_nan = payload(0.5);
+        let length = trailing_nan.len();
+        trailing_nan[length - 4..].copy_from_slice(&f32::NAN.to_le_bytes());
+        assert!(validate_ply(&trailing_nan).is_err());
+        assert!(validate_ply(b"ply\nformat binary_little_endian 1.0\nelement vertex 1\nproperty float x\nend_header\n").is_err());
+    }
+
+    #[test]
+    fn commits_atomically_and_preserves_previous_on_partial_write_or_panic() {
+        let directory = test_directory();
+        let path = directory.join("checkpoint.ply");
+        let old = payload(0.25);
+        let new = payload(0.75);
+        write_checkpoint_with(&path, &old, |file, data| file.write_all(data)).unwrap();
+        let result = write_checkpoint_with(&path, &new, |file, data| {
+            file.write_all(&data[..data.len() / 2])?;
+            Err(io::Error::other("injected disk full"))
+        });
+        assert!(result.is_err());
+        assert_eq!(std::fs::read(&path).unwrap(), old);
+        let interrupted = std::panic::catch_unwind(|| {
+            let _ = write_checkpoint_with(&path, &new, |file, data| {
+                file.write_all(&data[..data.len() / 2])?;
+                panic!("interrupted writer");
+            });
+        });
+        assert!(interrupted.is_err());
+        assert_eq!(std::fs::read(&path).unwrap(), old);
+        assert_eq!(std::fs::read_dir(&directory).unwrap().count(), 1);
+        write_checkpoint_with(&path, &new, |file, data| file.write_all(data)).unwrap();
+        assert_eq!(std::fs::read(&path).unwrap(), new);
+        assert!(
+            write_checkpoint_with(&path, &payload(f32::NAN), |file, data| file.write_all(data))
+                .is_err()
+        );
+        assert_eq!(std::fs::read(&path).unwrap(), new);
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+}
