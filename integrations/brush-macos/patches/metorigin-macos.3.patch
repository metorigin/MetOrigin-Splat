+/// Handle machine modes before constructing either the viewer or training runtime.
+pub fn handle_machine_mode(args: &Cli) -> anyhow::Result<bool> {
+    use std::io::Write;
+    use std::panic::{AssertUnwindSafe, catch_unwind};
+    if args.capabilities_json {
+        writeln!(
+            std::io::stdout().lock(),
+            "{}",
+            brush_process::machine::capabilities()
+        )?;
+        return Ok(true);
+    }
+    if args.probe_json {
+        let outcome = catch_unwind(AssertUnwindSafe(|| -> anyhow::Result<_> {
+            let runtime = tokio::runtime::Builder::new_multi_thread()
+                .enable_all()
+                .build()?;
+            runtime.block_on(brush_process::machine::probe())
+        }))
+        .unwrap_or_else(|_| Err(anyhow::anyhow!("Compute probe panicked")));
+        let (report, success) = brush_process::machine::probe_outcome(outcome);
+        writeln!(std::io::stdout().lock(), "{report}")?;
+        anyhow::ensure!(success, "GPU compute probe failed");
+        return Ok(true);
+    }
+    Ok(false)
+}
