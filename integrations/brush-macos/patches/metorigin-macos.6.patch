@@ -0,0 +1,78 @@
+//! Delegate the application's logger while temporarily hiding progress output.
+//!
+//! Implemented against the public `log` and `indicatif` APIs. This module does
+//! not incorporate source from an external logging bridge.
+
+use indicatif::MultiProgress;
+use log::{Log, Metadata, Record};
+
+pub(crate) struct ProgressLogger<L> {
+    progress: MultiProgress,
+    logger: L,
+}
+
+impl<L: Log> ProgressLogger<L> {
+    pub(crate) fn new(progress: MultiProgress, logger: L) -> Self {
+        Self { progress, logger }
+    }
+}
+
+impl<L: Log> Log for ProgressLogger<L> {
+    fn enabled(&self, metadata: &Metadata<'_>) -> bool {
+        self.logger.enabled(metadata)
+    }
+
+    fn log(&self, record: &Record<'_>) {
+        if self.enabled(record.metadata()) {
+            self.progress.suspend(|| self.logger.log(record));
+        }
+    }
+
+    fn flush(&self) {
+        self.progress.suspend(|| self.logger.flush());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{Arc, Mutex};
+
+    #[derive(Clone, Default)]
+    struct RecordingLogger(Arc<Mutex<Vec<String>>>);
+
+    impl Log for RecordingLogger {
+        fn enabled(&self, metadata: &Metadata<'_>) -> bool {
+            metadata.level() <= log::Level::Info
+        }
+
+        fn log(&self, record: &Record<'_>) {
+            self.0.lock().unwrap().push(record.args().to_string());
+        }
+
+        fn flush(&self) {
+            self.0.lock().unwrap().push("flushed".into());
+        }
+    }
+
+    #[test]
+    fn delegates_filter_records_and_flush_without_global_logger_state() {
+        let recorder = RecordingLogger::default();
+        let logger = ProgressLogger::new(MultiProgress::new(), recorder.clone());
+        assert!(!logger.enabled(&Metadata::builder().level(log::Level::Debug).build()));
+        logger.log(
+            &Record::builder()
+                .level(log::Level::Debug)
+                .args(format_args!("filtered"))
+                .build(),
+        );
+        logger.log(
+            &Record::builder()
+                .level(log::Level::Info)
+                .args(format_args!("step {}", 42))
+                .build(),
+        );
+        logger.flush();
+        assert_eq!(*recorder.0.lock().unwrap(), ["step 42", "flushed"]);
+    }
+}
