+        } else if ch == '\\' && quote != Some('\'') {
+            escaped = true;
+            started = true;
+        } else if quote == Some(ch) {
+            quote = None;
+        } else if quote.is_none() && (ch == '\'' || ch == '"') {
+            quote = Some(ch);
+            started = true;
+        } else if quote.is_none() && ch.is_whitespace() {
+            if started {
+                args.push(std::mem::take(&mut token));
+                started = false;
+            }
+        } else {
+            token.push(ch);
+            started = true;
+        }
+    }
+    if escaped || quote.is_some() {
+        return Err("Unterminated quote or escape in args.txt");
+    }
+    if started {
+        args.push(token);
+    }
+    Ok(args)
+}
