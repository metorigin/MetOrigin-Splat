+//! Demand-driven protocol-1 PLY bridge, independent of the training stream.
+
+use std::{
+    fs::{File, OpenOptions},
+    future::Future,
+    io::Write,
+    path::{Path, PathBuf},
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+
+use anyhow::{Context, Result, ensure};
+use brush_async::Actor;
+use serde::{Deserialize, Serialize};
+use tokio::sync::oneshot;
+
+use crate::{slot::Slot, snapshot::TrainingSnapshot};
+
+const PROTOCOL: u32 = 1;
+
+#[derive(Deserialize)]
+struct Session {
+    protocol: u32,
+    session_id: String,
+    available: bool,
+    running: bool,
+}
+
+#[derive(Deserialize)]
+struct Request {
+    session_id: String,
+    after_revision: u64,
+    mode: String,
+    expires_at_ms: u64,
+}
+
+#[derive(Serialize, Deserialize)]
+struct Frame {
+    protocol: u32,
+    session_id: String,
+    revision: u64,
+    iteration: u32,
+    splat_count: u32,
+    relative_path: String,
+    created_at_ms: u64,
+}
+
+struct Producer {
+    directory: PathBuf,
+    session_id: String,
+    revision: u64,
+    last_iteration: Option<u32>,
+    finishing: bool,
+}
+
+impl Producer {
+    fn new(directory: &Path, session_id: String) -> Result<Self> {
+        ensure!(
+            !session_id.is_empty()
+                && session_id.len() <= 128
+                && session_id
+                    .chars()
+                    .all(|ch| ch.is_ascii_hexdigit() || ch == '-'),
+            "Invalid live preview session ID"
+        );
+        let directory = directory
+            .canonicalize()
+            .context("Opening live preview directory")?;
+        ensure!(
+            directory.file_name().and_then(|s| s.to_str()) == Some(&session_id),
+            "Live preview directory must belong to the session"
+        );
+        ensure!(
+            !directory.join("latest.json").exists(),
+            "Live preview session was already used"
+        );
+        Ok(Self {
+            directory,
+            session_id,
+            revision: 0,
+            last_iteration: None,
+            finishing: false,
+        })
+    }
+
+    fn request(&self, now: u64) -> Option<Request> {
+        let session: Session = read_small_json(&self.directory.parent()?.join("session.json"))?;
+        if session.protocol != PROTOCOL
+            || session.session_id != self.session_id
+            || !session.running
+            || !session.available
+        {
+            return None;
+        }
+        let request: Request = read_small_json(&self.directory.join("request.json"))?;
+        (request.session_id == self.session_id
+            && request.expires_at_ms > now
+            && request.after_revision == self.revision
+            && matches!(request.mode.as_str(), "live" | "low"))
+        .then_some(request)
+    }
+
+    fn ready(&self, request: &Request, iteration: u32) -> bool {
+        let interval = if request.mode == "live" { 5 } else { 100 };
+        self.last_iteration.is_none_or(|last| {
+            iteration > last && (self.finishing || iteration.saturating_sub(last) >= interval)
+        })
+    }
+
+    /// Request validation precedes snapshot acquisition and encoding. The
+    /// closure boundary lets tests prove disabled/expired demand performs no readback.
+    async fn update_with<T, Snapshot, Encode, Encoded>(
+        &mut self,
+        snapshot: Snapshot,
+        encode: Encode,
+        cancelled: &AtomicBool,
+    ) -> Result<bool>
+    where
+        Snapshot: FnOnce() -> Option<(u32, u32, T)>,
+        Encode: FnOnce(T) -> Encoded,
+        Encoded: Future<Output = Result<Vec<u8>>>,
+    {
+        if cancelled.load(Ordering::Acquire) {
+            return Ok(false);
+        }
+        let Some(request) = self.request(now_ms()) else {
+            return Ok(false);
+        };
+        let Some((iteration, splat_count, model)) = snapshot() else {
+            return Ok(false);
+        };
+        if !self.ready(&request, iteration) {
+            return Ok(false);
+        }
+        // Exactly one immutable shallow snapshot is held during encoding.
+        let bytes = encode(model).await?;
+        if cancelled.load(Ordering::Acquire)
+            || !self
+                .request(now_ms())
+                .is_some_and(|request| self.ready(&request, iteration))
+        {
+            return Ok(false);
+        }
+        let revision = self
+            .revision
+            .checked_add(1)
+            .context("Live revision overflow")?;
+        let relative_path = format!("frame-{revision}.ply");
+        let path = self.directory.join(&relative_path);
+        // This dedicated actor can perform blocking disk I/O without blocking
+        // the trainer. No detached write can publish after actor cancellation.
+        crate::checkpoint::write_checkpoint_sync(&path, &bytes)?;
+        if cancelled.load(Ordering::Acquire) || self.request(now_ms()).is_none() {
+            let _ = std::fs::remove_file(path);
+            return Ok(false);
+        }
+        let frame = Frame {
+            protocol: PROTOCOL,
+            session_id: self.session_id.clone(),
+            revision,
+            iteration,
+            splat_count,
+            relative_path,
+            created_at_ms: now_ms(),
+        };
+        if let Err(error) = write_latest(&self.directory, &frame) {
+            let _ = std::fs::remove_file(path);
+            return Err(error);
+        }
+        self.revision = revision;
+        self.last_iteration = Some(iteration);
+        // Keep the previous acknowledged frame during a viewer swap.
+        if revision > 2 {
+            let _ =
+                std::fs::remove_file(self.directory.join(format!("frame-{}.ply", revision - 2)));
+        }
+        log::info!(
+            "MetOrigin live preview: iteration {iteration}, revision {revision}, {splat_count} splats"
+        );
+        Ok(true)
+    }
+
+    async fn update(
+        &mut self,
+        snapshots: &Slot<TrainingSnapshot>,
+        cancelled: &AtomicBool,
+    ) -> Result<bool> {
+        self.update_with(
+            || {
+                snapshots
+                    .latest()
+                    .map(|snapshot| (snapshot.iteration, snapshot.splats.num_splats(), snapshot))
+            },
+            |snapshot| async move {
+                // Match checkpoint semantics exactly: convert metres once and
+                // use the official serializer for Mip floor, rotation and SH.
+                brush_serde::splat_to_ply(
+                    snapshot.splats.scaled(snapshot.units_per_meter),
+                    snapshot.up_axis,
+                )
+                .await
+                .context("Serializing live Gaussian snapshot")
+            },
+            cancelled,
+        )
+        .await
+    }
+}
+
+fn read_small_json<T: for<'de> Deserialize<'de>>(path: &Path) -> Option<T> {
+    if std::fs::metadata(path).ok()?.len() > 4096 {
+        return None;
+    }
+    serde_json::from_slice(&std::fs::read(path).ok()?).ok()
+}
+
+struct TemporaryMetadata(PathBuf);
+impl Drop for TemporaryMetadata {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.0);
+    }
+}
+
+fn write_latest(directory: &Path, frame: &Frame) -> Result<()> {
+    let temporary = TemporaryMetadata(directory.join(format!("latest-{}.tmp", frame.revision)));
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&temporary.0)?;
+    file.write_all(&serde_json::to_vec(frame)?)?;
+    file.sync_all()?;
+    std::fs::rename(&temporary.0, directory.join("latest.json"))?;
+    #[cfg(unix)]
+    File::open(directory)?.sync_all()?;
+    Ok(())
+}
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis() as u64
+}
+
+/// Owns an independent actor and a single in-flight snapshot. Dropping cancels
+/// readback/publication; normal completion checks the final slot once for demand.
+pub struct LiveBridge {
+    _actor: Actor,
+    shutdown: Option<oneshot::Sender<()>>,
+    done: Option<oneshot::Receiver<()>>,
+    cancelled: Arc<AtomicBool>,
+}
+
+impl LiveBridge {
+    pub fn from_env(snapshots: Slot<TrainingSnapshot>) -> Result<Option<Self>> {
+        let Some(directory) = std::env::var_os("METORIGIN_BRUSH_LIVE_DIR") else {
+            return Ok(None);
+        };
+        let session_id =
+            std::env::var("METORIGIN_BRUSH_LIVE_SESSION").context("Missing live session")?;
+        let mut producer = Producer::new(Path::new(&directory), session_id)?;
+        let actor = Actor::new("metorigin-live-preview");
+        let cancelled = Arc::new(AtomicBool::new(false));
+        let worker_cancelled = cancelled.clone();
+        let (shutdown, mut shutdown_rx) = oneshot::channel();
+        let (done_tx, done) = oneshot::channel();
+        actor
+            .run(move || async move {
+                loop {
+                    let finishing = tokio::select! {
+                        _ = &mut shutdown_rx => true,
+                        _ = tokio::time::sleep(Duration::from_millis(100)) => false,
+                    };
+                    if worker_cancelled.load(Ordering::Acquire) {
+                        break;
+                    }
+                    producer.finishing = finishing;
+                    if let Err(error) = producer.update(&snapshots, &worker_cancelled).await {
+                        log::warn!("Live preview disabled after export failure: {error:#}");
+                        break;
+                    }
+                    if finishing {
+                        break;
+                    }
+                }
+                let _ = done_tx.send(());
+            })
+            .detach();
+        Ok(Some(Self {
+            _actor: actor,
+            shutdown: Some(shutdown),
+            done: Some(done),
+            cancelled,
+        }))
+    }
+
+    pub async fn finish(&mut self) {
+        if let Some(shutdown) = self.shutdown.take() {
+            let _ = shutdown.send(());
+        }
+        if let Some(done) = self.done.take()
+            && tokio::time::timeout(Duration::from_secs(30), done)
+                .await
+                .is_err()
+        {
+            log::warn!("Live preview final snapshot timed out");
+        }
+        self.cancelled.store(true, Ordering::Release);
+    }
+}
+
+impl Drop for LiveBridge {
+    fn drop(&mut self) {
+        self.cancelled.store(true, Ordering::Release);
+        if let Some(shutdown) = self.shutdown.take() {
+            let _ = shutdown.send(());
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    use std::{cell::Cell, sync::atomic::AtomicU64};
+
+    static NEXT_TEST: AtomicU64 = AtomicU64::new(0);
+    struct Fixture {
+        root: PathBuf,
+        producer: Producer,
+    }
+    impl Fixture {
+        fn new() -> Self {
+            let number = NEXT_TEST.fetch_add(1, Ordering::Relaxed);
+            let root =
+                std::env::temp_dir().join(format!("brush-live-{}-{number}", std::process::id()));
+            let directory = root.join("abcd-1234");
+            std::fs::create_dir_all(&directory).unwrap();
+            std::fs::write(
+                root.join("session.json"),
+                json!({
+                    "protocol":1, "session_id":"abcd-1234", "available":true, "running":true
+                })
+                .to_string(),
+            )
+            .unwrap();
+            Self {
+                root,
+                producer: Producer::new(&directory, "abcd-1234".into()).unwrap(),
+            }
+        }
+        fn request(&self, after_revision: u64, mode: &str, expires_at_ms: u64) {
+            std::fs::write(
+                self.producer.directory.join("request.json"),
+                json!({
+                    "session_id":"abcd-1234", "after_revision":after_revision,
+                    "mode":mode, "expires_at_ms":expires_at_ms
+                })
+                .to_string(),
+            )
+            .unwrap();
+        }
+    }
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_dir_all(&self.root);
+        }
+    }
+
+    fn small_ply() -> Vec<u8> {
+        let mut bytes = b"ply\nformat binary_little_endian 1.0\nelement vertex 1\n".to_vec();
+        for field in [
+            "x", "y", "z", "scale_0", "scale_1", "scale_2", "opacity", "rot_0", "rot_1", "rot_2",
+            "rot_3", "f_dc_0", "f_dc_1", "f_dc_2",
+        ] {
+            bytes.extend(format!("property float {field}\n").as_bytes());
+        }
+        bytes.extend(b"end_header\n");
+        bytes.extend([0u8; 14 * 4]);
+        bytes
+    }
+
+    async fn fake_update(producer: &mut Producer, iteration: u32, reads: &Cell<u32>) -> bool {
+        producer
+            .update_with(
+                || Some((iteration, 1, ())),
+                |()| async {
+                    reads.set(reads.get() + 1);
+                    Ok(small_ply())
+                },
+                &AtomicBool::new(false),
+            )
+            .await
+            .unwrap()
+    }
+
+    #[tokio::test]
+    async fn empty_slot_and_invalid_demand_never_read_back() {
+        let mut fixture = Fixture::new();
+        let reads = Cell::new(0);
+        assert!(!fake_update(&mut fixture.producer, 1, &reads).await);
+        fixture.request(0, "off", now_ms() + 10_000);
+        assert!(!fake_update(&mut fixture.producer, 1, &reads).await);
+        fixture.request(0, "live", now_ms().saturating_sub(1));
+        assert!(!fake_update(&mut fixture.producer, 1, &reads).await);
+        fixture.request(1, "live", now_ms() + 10_000);
+        assert!(!fake_update(&mut fixture.producer, 1, &reads).await);
+        fixture.request(0, "live", now_ms() + 10_000);
+        let empty: Slot<TrainingSnapshot> = Slot::empty();
+        assert!(
+            !fixture
+                .producer
+                .update(&empty, &AtomicBool::new(false))
+                .await
+                .unwrap()
+        );
+        assert!(
+            !fixture
+                .producer
+                .update_with(
+                    || -> Option<(u32, u32, ())> { panic!("cancelled bridge accessed snapshot") },
+                    |()| async { panic!("cancelled bridge read GPU") },
+                    &AtomicBool::new(true),
+                )
+                .await
+                .unwrap()
+        );
+        std::fs::write(
+            fixture.root.join("session.json"),
+            json!({
+                "protocol":1, "session_id":"ffff-9999", "available":true, "running":true
+            })
+            .to_string(),
+        )
+        .unwrap();
+        assert!(!fake_update(&mut fixture.producer, 1, &reads).await);
+        assert_eq!(reads.get(), 0);
+        assert_eq!(fixture.producer.revision, 0);
+        assert!(!fixture.producer.directory.join("latest.json").exists());
+    }
+
+    #[tokio::test]
+    async fn one_frame_per_ack_and_expired_or_stale_ack_does_not_advance() {
+        let mut fixture = Fixture::new();
+        let reads = Cell::new(0);
+        fixture.request(0, "live", now_ms() + 10_000);
+        assert!(fake_update(&mut fixture.producer, 10, &reads).await);
+        assert!(!fake_update(&mut fixture.producer, 20, &reads).await);
+        fixture.request(1, "live", now_ms() + 10_000);
+        assert!(!fake_update(&mut fixture.producer, 12, &reads).await);
+        assert!(fake_update(&mut fixture.producer, 20, &reads).await);
+        fixture.request(1, "live", now_ms() + 10_000);
+        assert!(!fake_update(&mut fixture.producer, 30, &reads).await);
+        fixture.request(2, "live", now_ms().saturating_sub(1));
+        assert!(!fake_update(&mut fixture.producer, 30, &reads).await);
+        fixture.request(2, "low", now_ms() + 10_000);
+        assert!(!fake_update(&mut fixture.producer, 30, &reads).await);
+        assert!(fake_update(&mut fixture.producer, 120, &reads).await);
+        assert_eq!(reads.get(), 3);
+        assert_eq!(fixture.producer.revision, 3);
+        assert!(!fixture.producer.directory.join("frame-1.ply").exists());
+        assert!(fixture.producer.directory.join("frame-2.ply").exists());
+        assert!(fixture.producer.directory.join("frame-3.ply").exists());
+        let frame: Frame =
+            read_small_json(&fixture.producer.directory.join("latest.json")).unwrap();
+        assert_eq!(frame.iteration, 120);
+        assert_eq!(frame.revision, 3);
+    }
+
+    #[tokio::test]
+    async fn normal_finish_can_publish_requested_final_iteration_before_interval() {
+        let mut fixture = Fixture::new();
+        let reads = Cell::new(0);
+        fixture.request(0, "low", now_ms() + 10_000);
+        assert!(fake_update(&mut fixture.producer, 10, &reads).await);
+        fixture.request(1, "low", now_ms() + 10_000);
+        assert!(!fake_update(&mut fixture.producer, 11, &reads).await);
+        fixture.producer.finishing = true;
+        assert!(fake_update(&mut fixture.producer, 11, &reads).await);
+        fixture.request(2, "low", now_ms() + 10_000);
+        assert!(!fake_update(&mut fixture.producer, 11, &reads).await);
+        assert_eq!(reads.get(), 2);
+    }
+
+    #[tokio::test]
+    async fn closing_preview_during_encode_cannot_publish() {
+        let mut fixture = Fixture::new();
+        fixture.request(0, "live", now_ms() + 10_000);
+        let request_path = fixture.producer.directory.join("request.json");
+        assert!(
+            !fixture
+                .producer
+                .update_with(
+                    || Some((10, 1, ())),
+                    |()| async move {
+                        std::fs::write(
+                            request_path,
+                            json!({
+                                "session_id":"abcd-1234", "after_revision":0,
+                                "mode":"off", "expires_at_ms":now_ms()+10_000
+                            })
+                            .to_string(),
+                        )?;
+                        Ok(small_ply())
+                    },
+                    &AtomicBool::new(false)
+                )
+                .await
+                .unwrap()
+        );
+        assert_eq!(fixture.producer.revision, 0);
+        assert!(!fixture.producer.directory.join("latest.json").exists());
+        assert!(!fixture.producer.directory.join("frame-1.ply").exists());
+    }
+
+    #[tokio::test]
+    #[ignore = "requires Metal and METORIGIN_BRUSH_TEST_DATASET with a normalized local fixture"]
+    async fn actual_snapshot_equals_same_iteration_checkpoint_with_nonunit_scale_and_sh() {
+        use clap::Parser;
+        use tokio_stream::StreamExt;
+        let fixture_path = std::env::var("METORIGIN_BRUSH_TEST_DATASET").expect("fixture path");
+        let (_, adapter) = crate::burn_init_setup_with_info().await;
+        assert_eq!(adapter.backend, wgpu::Backend::Metal);
+        let mut fixture = Fixture::new();
+        let export_dir = fixture.root.join("checkpoints");
+        let mut config = crate::config::TrainStreamConfig::parse_from(["brush"]);
+        config.train_config.total_train_iters = 10;
+        config.train_config.max_splats = 50_000;
+        config.model_config.sh_degree = 2;
+        config.load_config.max_resolution = 160;
+        config.load_config.max_scene_batch_cache_size = 16 * 1024 * 1024;
+        config.load_config.num_loader_threads = std::num::NonZeroUsize::new(2);
+        config.load_config.units_per_meter = 1000.0;
+        config.process_config.export_path = export_dir.to_str().unwrap().into();
+        config.process_config.export_name = "checkpoint_{iter}.ply".into();
+        let mut process =
+            crate::create_process(crate::DataSource::Path(fixture_path), async move |_| {
+                Some(config)
+            });
+        while let Some(message) = process.stream.next().await {
+            message.unwrap();
+        }
+        let snapshot = process.training_snapshots.latest().unwrap();
+        assert_eq!(snapshot.iteration, 10);
+        assert_eq!(snapshot.units_per_meter, 1000.0);
+        assert_eq!(snapshot.splats.sh_degree(), 2);
+        fixture.request(0, "live", now_ms() + 10_000);
+        assert!(
+            fixture
+                .producer
+                .update(&process.training_snapshots, &AtomicBool::new(false))
+                .await
+                .unwrap()
+        );
+        let frame: Frame =
+            read_small_json(&fixture.producer.directory.join("latest.json")).unwrap();
+        assert_eq!(frame.iteration, snapshot.iteration);
+        assert_eq!(frame.splat_count, snapshot.splats.num_splats());
+        assert_eq!(
+            std::fs::read(export_dir.join("checkpoint_10.ply")).unwrap(),
+            std::fs::read(fixture.producer.directory.join(frame.relative_path)).unwrap()
+        );
+    }
+}
