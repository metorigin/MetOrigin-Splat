+//! Versioned headless-machine interfaces; capabilities never initialize a GPU.
+
+use anyhow::{Context, Result, ensure};
+use brush_render::kernels::camera_model::CameraModel;
+use brush_render::{Splats, bwd, camera::Camera, gaussian_splats::SplatRenderMode};
+use burn::{module::Module, tensor::Tensor};
+use serde_json::{Value, json};
+
+pub const ENGINE_VERSION: &str = "1.0.0+metorigin-macos.2";
+pub const SOURCE_COMMIT: &str = "1388f74c6fe0236f68ee4915564bf00e9d2e3747";
+pub const BUILD_ID: &str = "metorigin-macos.2";
+const GAUSSIANS: usize = 8;
+const SIZE: u32 = 32;
+
+fn identity() -> Value {
+    json!({
+        "schema_version": 1,
+        "engine": "brush",
+        "engine_version": ENGINE_VERSION,
+        "source_commit": SOURCE_COMMIT,
+        "build_id": BUILD_ID,
+    })
+}
+
+pub fn capabilities() -> Value {
+    let mut report = identity();
+    report["cli_profile"] = json!("metorigin_1");
+    report["target"] = if cfg!(all(target_os = "macos", target_arch = "aarch64")) {
+        json!("aarch64-apple-darwin")
+    } else {
+        json!(format!(
+            "{}-{}",
+            std::env::consts::ARCH,
+            std::env::consts::OS
+        ))
+    };
+    report["supported_features"] = json!([
+        "capabilities_json",
+        "compute_probe",
+        "ply_checkpoint",
+        "ply_warm_start"
+    ]);
+    report["live_protocol"] = json!("disabled");
+    report["resume_mode"] = json!("ply_warm_start_optimizer_reset");
+    report
+}
+
+pub fn failed_probe() -> Value {
+    let mut report = identity();
+    report["probe_kind"] = json!("compute_smoke");
+    report["status"] = json!("failed");
+    report["backend"] = Value::Null;
+    report["device_name"] = Value::Null;
+    report["error"] = json!({
+        "code": "BRUSH_GPU_PROBE_FAILED",
+        "message": "The training GPU could not complete the Gaussian compute check.",
+        "retryable": false,
+    });
+    report
+}
+
+fn validate_compute(pixels: &[f32], gradients: &[f32], loss: f32) -> Result<f64> {
+    ensure!(
+        pixels.len() == (SIZE * SIZE * 4) as usize,
+        "Unexpected rendered image size"
+    );
+    ensure!(
+        pixels.iter().all(|value| value.is_finite()),
+        "Non-finite render output"
+    );
+    ensure!(
+        pixels.iter().any(|value| *value > 0.0),
+        "Empty render output"
+    );
+    ensure!(gradients.len() == GAUSSIANS, "Missing opacity gradients");
+    ensure!(
+        gradients.iter().all(|value| value.is_finite()),
+        "Non-finite backward output"
+    );
+    ensure!(loss.is_finite() && loss > 0.0, "Invalid rendered loss");
+    let gradient_l1 = gradients
+        .iter()
+        .map(|value| f64::from(value.abs()))
+        .sum::<f64>();
+    ensure!(
+        gradient_l1 > 0.0 && gradient_l1.is_finite(),
+        "Empty backward output"
+    );
+    Ok(gradient_l1)
+}
+
+/// Run real projection/rasterization and its Gaussian backward kernels.
+/// The fixed eight visible splats keep this independent of user datasets.
+pub async fn probe() -> Result<Value> {
+    let (device, adapter) = crate::burn_init_setup_with_info().await;
+    ensure!(
+        adapter.backend == wgpu::Backend::Metal,
+        "Expected a Metal compute adapter"
+    );
+    let mut positions = Vec::with_capacity(GAUSSIANS * 3);
+    for index in 0..GAUSSIANS {
+        positions.extend([
+            if index & 1 == 0 { -0.15 } else { 0.15 },
+            if index & 2 == 0 { -0.15 } else { 0.15 },
+            2.0 + if index & 4 == 0 { 0.0 } else { 0.2 },
+        ]);
+    }
+    let splats = Splats::from_raw(
+        positions,
+        [0.0, 0.0, 0.0, 1.0].repeat(GAUSSIANS),
+        vec![-2.0; GAUSSIANS * 3],
+        vec![0.2; GAUSSIANS * 3],
+        vec![0.0; GAUSSIANS],
+        SplatRenderMode::Default,
+        &device,
+    )
+    .train();
+    let camera = Camera::new(
+        glam::Vec3::ZERO,
+        glam::Quat::IDENTITY,
+        0.7,
+        0.7,
+        glam::vec2(0.5, 0.5),
+        CameraModel::Pinhole,
+    );
+    let output = bwd::render_splats(
+        splats.clone(),
+        &camera,
+        glam::uvec2(SIZE, SIZE),
+        glam::Vec3::ZERO,
+    )
+    .await;
+    ensure!(
+        output.num_visible == GAUSSIANS as u32,
+        "Probe scene was not fully visible"
+    );
+    let pixels = output
+        .img
+        .clone()
+        .into_data_async()
+        .await
+        .context("Reading rendered pixels")?
+        .try_to_vec::<f32>()
+        .context("Decoding rendered pixels")?;
+    let loss: Tensor<1> = output.img.mean();
+    let loss_value = loss
+        .clone()
+        .into_scalar_async::<f32>()
+        .await
+        .context("Reading rendered loss")?;
+    let gradients = loss.backward();
+    let opacity_gradients = splats
+        .raw_opacities
+        .grad(&gradients)
+        .context("Gaussian backward did not produce opacity gradients")?
+        .into_data_async()
+        .await
+        .context("Reading Gaussian gradients")?
+        .try_to_vec::<f32>()
+        .context("Decoding Gaussian gradients")?;
+    let gradient_l1 = validate_compute(&pixels, &opacity_gradients, loss_value)?;
+    device.sync().context("Synchronizing GPU probe")?;
+    let mut report = identity();
+    report["probe_kind"] = json!("compute_smoke");
+    report["status"] = json!("supported");
+    report["backend"] = json!("metal");
+    report["device_name"] = json!(adapter.name);
+    report["device_type"] = json!(format!("{:?}", adapter.device_type));
+    report["compute"] = json!({
+        "gaussian_count": GAUSSIANS,
+        "width": SIZE, "height": SIZE,
+        "forward_finite": true, "gradient_finite": true,
+        "loss": loss_value, "gradient_l1": gradient_l1,
+    });
+    Ok(report)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn capabilities_state_only_implemented_contracts() {
+        let report = capabilities();
+        assert_eq!(report["schema_version"], 1);
+        assert_eq!(report["cli_profile"], "metorigin_1");
+        assert_eq!(report["live_protocol"], "disabled");
+        assert_eq!(report["resume_mode"], "ply_warm_start_optimizer_reset");
+        assert_eq!(report["build_id"], BUILD_ID);
+        assert!(!report.to_string().contains("atomic_checkpoint"));
+    }
+
+    #[test]
+    fn failure_is_structured_and_contains_no_raw_cause() {
+        let report = failed_probe();
+        assert_eq!(report["status"], "failed");
+        assert!(report["backend"].is_null());
+        assert_eq!(report["error"]["code"], "BRUSH_GPU_PROBE_FAILED");
+    }
+
+    #[test]
+    fn compute_validation_rejects_noop_nonfinite_or_missing_backward() {
+        let pixels = vec![0.5; (SIZE * SIZE * 4) as usize];
+        assert!(validate_compute(&pixels, &[0.1; GAUSSIANS], 0.5).is_ok());
+        assert!(validate_compute(&pixels, &[0.0; GAUSSIANS], 0.5).is_err());
+        assert!(validate_compute(&pixels, &[f32::NAN; GAUSSIANS], 0.5).is_err());
+        assert!(validate_compute(&pixels, &[], 0.5).is_err());
+        assert!(validate_compute(&pixels, &[0.1; GAUSSIANS], f32::INFINITY).is_err());
+        assert!(validate_compute(&[], &[0.1; GAUSSIANS], 0.5).is_err());
+    }
+
+    #[tokio::test]
+    #[ignore = "requires a real Apple Silicon Metal GPU"]
+    async fn metal_probe_executes_render_and_backward() {
+        let report = probe().await.expect("real GPU compute probe");
+        assert_eq!(report["backend"], "metal");
+        assert!(report["compute"]["gradient_l1"].as_f64().unwrap() > 0.0);
+    }
+}
