+    #[cfg(windows)]
+    #[test]
+    fn windows_reader_sharing_and_exclusive_target_preserve_valid_checkpoints() {
+        use std::os::windows::fs::OpenOptionsExt;
+        let directory = test_directory();
+        let path = directory.join("checkpoint.ply");
+        let old = payload(0.25);
+        let new = payload(0.75);
+        write_checkpoint_sync(&path, &old).unwrap();
+        // Rust readers share delete; replacement must work while the old reader
+        // keeps its own handle, and the new pathname must be a complete model.
+        let mut reader = File::open(&path).unwrap();
+        write_checkpoint_sync(&path, &new).unwrap();
+        let mut observed = Vec::new();
+        std::io::Read::read_to_end(&mut reader, &mut observed).unwrap();
+        assert_eq!(observed, old);
+        assert_eq!(std::fs::read(&path).unwrap(), new);
+        drop(reader);
+        let locked = OpenOptions::new()
+            .read(true)
+            .share_mode(0)
+            .open(&path)
+            .unwrap();
+        assert!(write_checkpoint_sync(&path, &old).is_err());
+        drop(locked);
+        assert_eq!(std::fs::read(&path).unwrap(), new);
+        assert_eq!(std::fs::read_dir(&directory).unwrap().count(), 1);
+        write_checkpoint_sync(&path, &old).unwrap();
+        assert_eq!(std::fs::read(&path).unwrap(), old);
+        // A stale unpublished temporary file is never treated as a checkpoint.
+        std::fs::write(directory.join(".brush-checkpoint-stale.part"), b"partial").unwrap();
+        write_checkpoint_sync(&path, &new).unwrap();
+        assert_eq!(std::fs::read(&path).unwrap(), new);
+        std::fs::remove_dir_all(directory).unwrap();
+    }
 }
