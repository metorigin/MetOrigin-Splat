+//! Windows-only adapter selection shared by compute probes and CLI training.
+//!
+//! IDs identify the API, PCI vendor/device and exact UTF-8 adapter name. If two
+//! physical adapters have identical identity, selection is rejected as ambiguous.
+//! This deliberately never equates an NVIDIA enumeration index with a WGPU one.
+use anyhow::{Context, Result, ensure};
+use burn_cubecl::cubecl::wgpu::{WgpuBackend, WgpuDeviceKind};
+use burn_wgpu::{WgpuDevice, graphics::AutoGraphicsApi};
+
+#[derive(clap::ValueEnum, Clone, Copy, Debug, Eq, PartialEq)]
+pub enum GraphicsBackend {
+    Dx12,
+    Vulkan,
+}
+
+impl GraphicsBackend {
+    fn api(self) -> wgpu::Backend {
+        match self {
+            Self::Dx12 => wgpu::Backend::Dx12,
+            Self::Vulkan => wgpu::Backend::Vulkan,
+        }
+    }
+    fn pinned(self) -> WgpuBackend {
+        match self {
+            Self::Dx12 => WgpuBackend::Dx12,
+            Self::Vulkan => WgpuBackend::Vulkan,
+        }
+    }
+}
+
+pub fn adapter_id(info: &wgpu::AdapterInfo) -> Result<String> {
+    let backend = match info.backend {
+        wgpu::Backend::Dx12 => "dx12",
+        wgpu::Backend::Vulkan => "vulkan",
+        _ => anyhow::bail!("Unsupported Windows compute backend"),
+    };
+    let name = info
+        .name
+        .as_bytes()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect::<String>();
+    Ok(format!(
+        "{backend}:{:08x}:{:08x}:{name}",
+        info.vendor, info.device
+    ))
+}
+
+fn select(infos: &[wgpu::AdapterInfo], requested: Option<&str>) -> Result<usize> {
+    let ids = infos.iter().map(adapter_id).collect::<Result<Vec<_>>>()?;
+    let selected = if let Some(requested) = requested {
+        ids.iter()
+            .position(|id| id == requested)
+            .context("Verified GPU is no longer available on the selected backend")?
+    } else {
+        infos
+            .iter()
+            .position(|info| info.device_type == wgpu::DeviceType::DiscreteGpu)
+            .context("No discrete GPU is available on the selected Windows backend")?
+    };
+    ensure!(
+        infos[selected].device_type == wgpu::DeviceType::DiscreteGpu,
+        "This Windows profile requires a discrete GPU"
+    );
+    ensure!(
+        ids.iter().filter(|id| **id == ids[selected]).count() == 1,
+        "GPU identity is ambiguous; refusing an unbound adapter"
+    );
+    Ok(selected)
+}
+
+pub async fn initialize(
+    backend: GraphicsBackend,
+    requested: Option<&str>,
+) -> Result<(crate::ProcessDevice, wgpu::AdapterInfo)> {
+    let instance = wgpu::Instance::new(wgpu::InstanceDescriptor {
+        backends: backend.api().into(),
+        ..wgpu::InstanceDescriptor::new_without_display_handle()
+    });
+    let adapters = instance.enumerate_adapters(backend.api().into()).await;
+    let infos = adapters
+        .iter()
+        .map(wgpu::Adapter::get_info)
+        .collect::<Vec<_>>();
+    let selected = select(&infos, requested)?;
+    let expected = &infos[selected];
+    ensure!(
+        adapters[selected]
+            .features()
+            .contains(wgpu::Features::SUBGROUP),
+        "Selected GPU lacks subgroup compute support. DX12 requires the packaged DXC compiler; FXC fallback cannot train Brush."
+    );
+    // CubeCL indexes adapters separately by DeviceType; resolve that index from
+    // WGPU on this same API, then verify the adapter returned by actual setup.
+    let index = infos[..selected]
+        .iter()
+        .filter(|info| info.device_type == expected.device_type)
+        .count();
+    let device = WgpuDevice::new(WgpuDeviceKind::DiscreteGpu(index)).on(backend.pinned());
+    let setup =
+        burn_wgpu::init_setup_async::<AutoGraphicsApi>(&device, crate::burn_options()).await;
+    let actual = setup.adapter.get_info();
+    ensure!(
+        actual.backend == backend.api() && adapter_id(&actual)? == adapter_id(expected)?,
+        "GPU selection changed during initialization"
+    );
+    Ok((device.into(), actual))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn info(name: &str, backend: wgpu::Backend) -> wgpu::AdapterInfo {
+        wgpu::AdapterInfo {
+            name: name.into(),
+            vendor: 0x10de,
+            device: 0x2c58,
+            device_type: wgpu::DeviceType::DiscreteGpu,
+            backend,
+            ..wgpu::AdapterInfo::new(wgpu::DeviceType::DiscreteGpu, backend)
+        }
+    }
+    #[test]
+    fn id_is_backend_bound_and_preserves_utf8_without_delimiter_ambiguity() {
+        let dx = info("GPU 中文:0", wgpu::Backend::Dx12);
+        assert_eq!(
+            adapter_id(&dx).unwrap(),
+            "dx12:000010de:00002c58:47505520e4b8ade696873a30"
+        );
+        assert_ne!(
+            adapter_id(&dx).unwrap(),
+            adapter_id(&info("GPU 中文:0", wgpu::Backend::Vulkan)).unwrap()
+        );
+    }
+    #[test]
+    fn identity_survives_reordering_and_rejects_missing_or_ambiguous_adapter() {
+        let a = info("first", wgpu::Backend::Dx12);
+        let b = info("second", wgpu::Backend::Dx12);
+        let id = adapter_id(&b).unwrap();
+        assert_eq!(select(&[a.clone(), b.clone()], Some(&id)).unwrap(), 1);
+        assert_eq!(select(&[b.clone(), a], Some(&id)).unwrap(), 0);
+        assert!(select(&[b.clone(), b], Some(&id)).is_err());
+        assert!(select(&[], Some(&id)).is_err());
+        assert!(select(&[info("first", wgpu::Backend::Vulkan)], Some(&id)).is_err());
+    }
+}
