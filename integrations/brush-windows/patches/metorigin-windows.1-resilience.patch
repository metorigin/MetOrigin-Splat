diff --git a/crates/brush-process/src/probe_diagnostics.rs b/crates/brush-process/src/probe_diagnostics.rs
new file mode 100644
index 0000000..88ac05f
--- /dev/null
+++ b/crates/brush-process/src/probe_diagnostics.rs
@@ -0,0 +1,206 @@
+//! Local diagnostics only: never copy raw causes or paths to machine stdout.
+use serde_json::{Value, json};
+use std::sync::{LazyLock, Mutex};
+
+static STATE: LazyLock<Mutex<Value>> = LazyLock::new(|| Mutex::new(json!({})));
+
+pub fn stage(stage: &str) {
+    STATE.lock().unwrap()["failure_stage"] = json!(stage);
+    eprintln!("[brush-probe] stage={stage}");
+}
+
+pub fn begin(backend: &str) {
+    *STATE.lock().unwrap() = json!({"backend": backend});
+    stage("initialization");
+    eprintln!(
+        "[brush-probe] os={} arch={} executable={:?}",
+        std::env::consts::OS,
+        std::env::consts::ARCH,
+        std::env::current_exe()
+    );
+}
+
+pub fn adapter(info: &wgpu::AdapterInfo) {
+    eprintln!("[brush-probe] actual_adapter={info:#?}");
+    let mut state = STATE.lock().unwrap();
+    state["device_name"] = json!(info.name);
+    state["device_type"] = json!(format!("{:?}", info.device_type));
+}
+
+pub fn failure(error: &anyhow::Error, report: &mut Value) {
+    let state = STATE.lock().unwrap();
+    eprintln!(
+        "[brush-probe] failure stage={} cause_chain={error:#}\nbacktrace={}",
+        state["failure_stage"],
+        error.backtrace()
+    );
+    for key in ["failure_stage", "backend", "device_name", "device_type"] {
+        if let Some(value) = state.get(key) {
+            report[key] = value.clone();
+        }
+    }
+    report["error"]["kind"] = json!(match state["failure_stage"].as_str() {
+        Some("adapter_selection" | "adapter_identity") => "invalid_selection",
+        Some("dependency_integrity") => "dependency_integrity",
+        Some("configuration") => "invalid_configuration",
+        _ => "backend_compute",
+    });
+}
+
+#[cfg(windows)]
+pub mod native {
+    use anyhow::{Context, Result, ensure};
+    use sha2::{Digest, Sha256};
+    use std::os::windows::process::CommandExt;
+    use std::{ffi::c_void, os::windows::ffi::OsStrExt, path::Path};
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn LoadLibraryExW(path: *const u16, file: *mut c_void, flags: u32) -> *mut c_void;
+        fn GetModuleFileNameW(module: *mut c_void, path: *mut u16, size: u32) -> u32;
+    }
+    #[link(name = "version")]
+    unsafe extern "system" {
+        fn GetFileVersionInfoSizeW(path: *const u16, handle: *mut u32) -> u32;
+        fn GetFileVersionInfoW(path: *const u16, handle: u32, size: u32, data: *mut c_void) -> i32;
+        fn VerQueryValueW(
+            data: *const c_void,
+            sub: *const u16,
+            value: *mut *mut c_void,
+            len: *mut u32,
+        ) -> i32;
+    }
+    fn wide(path: &Path) -> Vec<u16> {
+        path.as_os_str().encode_wide().chain(Some(0)).collect()
+    }
+    fn version(path: &Path) -> Result<String> {
+        let path = wide(path);
+        let mut ignored = 0;
+        // SAFETY: All pointers refer to live, correctly-sized buffers during the calls.
+        unsafe {
+            let size = GetFileVersionInfoSizeW(path.as_ptr(), &mut ignored);
+            ensure!(
+                size > 0,
+                "DLL version size: {}",
+                std::io::Error::last_os_error()
+            );
+            let mut data = vec![0u32; (size as usize).div_ceil(4)];
+            ensure!(
+                GetFileVersionInfoW(path.as_ptr(), 0, size, data.as_mut_ptr().cast()) != 0,
+                "DLL version data: {}",
+                std::io::Error::last_os_error()
+            );
+            let mut value = std::ptr::null_mut();
+            let mut len = 0;
+            ensure!(
+                VerQueryValueW(
+                    data.as_ptr().cast(),
+                    [92u16, 0].as_ptr(),
+                    &mut value,
+                    &mut len
+                ) != 0
+                    && len >= 52
+                    && !value.is_null(),
+                "DLL has no fixed version resource"
+            );
+            let fixed = std::slice::from_raw_parts(value.cast::<u32>(), 13);
+            ensure!(fixed[0] == 0xfeef04bd, "Invalid version resource signature");
+            Ok(format!(
+                "{}.{}.{}.{}",
+                fixed[2] >> 16,
+                fixed[2] & 65535,
+                fixed[3] >> 16,
+                fixed[3] & 65535
+            ))
+        }
+    }
+    pub fn inventory() {
+        let Ok(exe) = std::env::current_exe() else {
+            return;
+        };
+        for path in [
+            exe.clone(),
+            exe.with_file_name("dxcompiler.dll"),
+            exe.with_file_name("dxil.dll"),
+        ] {
+            let hash = std::fs::read(&path).map(|bytes| format!("{:x}", Sha256::digest(bytes)));
+            eprintln!(
+                "[brush-probe] file={} sha256={hash:?} version={:?}",
+                path.display(),
+                version(&path)
+            );
+        }
+        // Capture OS build without writing subprocess output to machine stdout.
+        if let Ok(result) = std::process::Command::new("cmd.exe")
+            .creation_flags(0x08000000)
+            .args(["/d", "/c", "ver"])
+            .output()
+        {
+            eprintln!(
+                "[brush-probe] os_version={}",
+                String::from_utf8_lossy(&result.stdout).trim()
+            );
+        }
+    }
+    pub fn load_packaged_dxc() -> Result<String> {
+        super::stage("dxc_loading");
+        let exe = std::env::current_exe().context("Locating packaged DXC")?;
+        for (name, expected) in [
+            (
+                "dxil.dll",
+                "62736e99aa534a942873f92b881a71b2cb6ad62b8d7481ea7a8ad8e9888a8056",
+            ),
+            (
+                "dxcompiler.dll",
+                "f79943b02f73b621421b58a569fd6ee120d0023fb6bfa23844ecad6b00d6a295",
+            ),
+        ] {
+            let path = exe
+                .with_file_name(name)
+                .canonicalize()
+                .with_context(|| format!("Packaged {name} missing"))?;
+            let digest = format!("{:x}", Sha256::digest(std::fs::read(&path)?));
+            if digest != expected {
+                super::stage("dependency_integrity");
+                anyhow::bail!(
+                    "Packaged {name} SHA-256 mismatch: expected {expected}, actual {digest}"
+                );
+            }
+            // Load only the sibling module and its directory/system dependencies.
+            // Retain this process-lifetime reference so DXIL cannot be unloaded or substituted.
+            let handle = unsafe {
+                LoadLibraryExW(wide(&path).as_ptr(), std::ptr::null_mut(), 0x100 | 0x800)
+            };
+            ensure!(
+                !handle.is_null(),
+                "Loading {} failed: {}",
+                path.display(),
+                std::io::Error::last_os_error()
+            );
+            let mut loaded = vec![0u16; 32768];
+            let len =
+                unsafe { GetModuleFileNameW(handle, loaded.as_mut_ptr(), loaded.len() as u32) }
+                    as usize;
+            ensure!(
+                len > 0 && len < loaded.len(),
+                "Could not identify loaded DXC module"
+            );
+            let loaded = std::path::PathBuf::from(String::from_utf16_lossy(&loaded[..len]))
+                .canonicalize()?;
+            ensure!(
+                loaded == path,
+                "Loaded module differs from packaged {name}: {}",
+                loaded.display()
+            );
+            eprintln!(
+                "[brush-probe] loaded_module={} sha256={digest} version={:?}",
+                loaded.display(),
+                version(&loaded)
+            );
+        }
+        Ok(exe
+            .with_file_name("dxcompiler.dll")
+            .canonicalize()?
+            .to_string_lossy()
+            .into_owned())
+    }
+}
